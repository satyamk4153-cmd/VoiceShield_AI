# ==============================================================================
# SentinelVoice Platform Configuration Template
# ==============================================================================

# Application Runtime Mode: 'production', 'development', or 'demo'
APP_MODE=development

# Security & Authentication (Required: Generate a 32+ character random string for production)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Production requires PostgreSQL; SQLite permitted in development only)
# Production: postgresql://sentineluser:sentinelpassword@postgres:5432/sentinelvoice
DATABASE_URL=sqlite:///./sentinelvoice.db

# Optional Redis Cache / Queue / Rate Limiting
# REDIS_URL=redis://localhost:6379/0

# AI Provider Selection: 'local' (offline DSP + ML), 'azure' (cloud API), or 'demo'
AI_PROVIDER=local

# Azure OpenAI (Required only when AI_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Speech (Optional for cloud STT and acoustic features)
AZURE_SPEECH_ENDPOINT=https://your-speech.cognitiveservices.azure.com/
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Azure AI Language (Optional for cloud PII redaction and conversational intent)
AZURE_LANGUAGE_ENDPOINT=https://your-language.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your-azure-language-key

# Audio Ingestion & Processing Limits
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300
ENABLE_RAW_AUDIO_RETENTION=false

# Rate Limiting & Network Security
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
