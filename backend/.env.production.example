APP_MODE=production
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql://sentineluser:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/sentinelvoice
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=local
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300
ENABLE_RAW_AUDIO_RETENTION=false
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=https://sentinelvoice.your-domain.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
